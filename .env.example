# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TMDB (The Movie Database) 
VITE_TMDB_API_KEY=

# Gemini (server-side only) — read by netlify/functions/recommend.mjs.
# Never give these a VITE_ prefix, or Vite will bundle them into the browser.
# Add the same variables in your Netlify dashboard (Site configuration ->
# Environment variables).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash